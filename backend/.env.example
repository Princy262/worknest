# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database (MongoDB Atlas) ----------
# Replace USERNAME, PASSWORD and CLUSTER_HOST. Keep /worknest as the database name.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/worknest?retryWrites=true&w=majority

# ---------- Authentication ----------
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ---------- Frontend ----------
CLIENT_URL=http://localhost:5173

# ---------- First account (used only by: npm run seed) ----------
PLATFORM_OWNER_NAME=Your Name
PLATFORM_OWNER_EMAIL=you@example.com
PLATFORM_OWNER_USERNAME=platformowner
PLATFORM_OWNER_PASSWORD=ChooseAStrongPassword1